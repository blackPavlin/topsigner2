# debug mode
DEBUG=true

# auth
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SIGNING_KEY=a-string-secret-at-least-256-bits-long
AUTH_ENCRYPTION_KEY=8f3kL9mN2pQrS7tVxYzA1bC4dE5fG6hI7jK8lM9nO0p=

# postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=topsigner
POSTGRES_SCHEMA=public
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_MAX_IDLE_CONNS=25
POSTGRES_CONN_MAX_IDLE_TIME=0

# redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis

# http server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s

# cors
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=300

# s3
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_IMAGE_BUCKET=images
S3_FONT_BUCKET=fonts
S3_SECURE=false

# vkid
VKID_BASE_URL=https://id.vk.ru
VKID_REDIRECT_URL=https://topsigner.ru/api/v1/auth/oauth/vkontakte/callback
VKID_SECRET_KEY=
VKID_SERVICE_KEY=
VKID_SCOPE=groups
REFRESH_TOKEN_TTL=4320h

# vk
VK_BASE_URL=https://api.vk.ru
