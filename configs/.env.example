# debug mode
DEBUG=true

# auth
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_SIGNING_KEY=a-string-secret-at-least-256-bits-long

# postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=topsigner
POSTGRES_SCHEMA=public
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_CONN_MAX_LIFETIME=5m
POSTGRES_MAX_IDLE_CONNS=25
POSTGRES_CONN_MAX_IDLE_TIME=0

# redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis

# http server
HTTP_PORT=8080

# cors
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=300

# s3
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_IMAGE_BUCKET=images
S3_FONT_BUCKET=fonts
S3_SECURE=false

# vkid
VKID_BASE_URL=https://id.vk.ru
VKID_CLIENT_ID=
VKID_REDIRECT_URL=
VKID_SCOPE=
